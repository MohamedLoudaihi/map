{
  "name": "okinawa-fuel-finder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Find reported fuel prices in Okinawa and station maps throughout Japan.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run test:js && npm run test:py",
    "test:js": "node --test tests/*.test.mjs",
    "test:py": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "refresh:prices": "python3 scripts/refresh_prices.py",
    "refresh:stations": "python3 scripts/refresh_stations.py",
    "dev": "python3 -m http.server 8000"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
